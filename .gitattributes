*.sh text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf

# Both carry shell inside them, so a CRLF clone would put a \r at the end of every line of
# the deploy step's `run: |` block and the VM would be asked to `git checkout dev\r`.
*.yml text eol=lf
*.yaml text eol=lf

# Not text: a `text=auto` or a Windows checkout could rewrite bytes inside a FlatBuffer or
# protobuf container and corrupt a model with no visible diff.
*.tflite binary
*.task binary
*.onnx binary
*.wasm binary
